// ─── Generator & Datasource ──────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum Gender {
  MONSIEUR
  MADAME
}

enum MaritalStatus {
  CELIBATAIRE
  MARIE
  PACSE
  DIVORCE
  VEUF
}

enum MatrimonialRegime {
  COMMUNAUTE_REDUITE_ACQUETS
  SEPARATION_BIENS
  COMMUNAUTE_UNIVERSELLE
  PARTICIPATION_ACQUETS
}

enum PersonType {
  PARTICULIER
  SOCIETE
}

enum Dpe {
  A
  B
  C
  D
  E
  F
  G
}

enum PropertyStatus {
  AVAILABLE    // Disponible à la vente
  UNDER_OFFER  // Offre en cours de traitement
  SOLD         // Vendu
}

enum OfferStatus {
  PENDING   // En attente de réponse du vendeur
  ACCEPTED  // Acceptée
  REJECTED  // Refusée
}

enum DocumentStatus {
  MISSING    // Document manquant — action requise
  PENDING    // Téléversé, en attente de validation
  VALIDATED  // Vérifié et validé
}

enum DocumentType {
  DPE                // Diagnostic de Performance Énergétique
  TITRE_PROPRIETE    // Titre de propriété (acte notarié)
  AMIANTE            // Diagnostic amiante
  PLOMB              // Constat de risque d'exposition au plomb
  TERMITES           // État relatif à la présence de termites
  MESURAGE_CARREZ    // Mesurage Loi Carrez
  ASSAINISSEMENT     // Assainissement non collectif
  ELECTRICITE        // Diagnostic électricité
  GAZ                // Diagnostic gaz
  OFFRE_ACHAT        // Offre d'achat générée par la plateforme
}

enum VisitStatus {
  PENDING    // En attente de confirmation vendeur
  CONFIRMED  // Confirmée
  CANCELLED  // Annulée
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  hashedPassword String
  role           Role       @default(BUYER)
  isPremium      Boolean    @default(false)
  credits        Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  properties       Property[]
  savedProperties  Property[]    @relation("UserSavedProperties")
  buyerProfile     BuyerProfile?
  buyerCriteria    BuyerCriteria?
  sellerProfile    SellerProfile?
  civilStatus      CivilStatus?
  sentMessages     Message[]     @relation("MessagesSent")
  receivedMessages Message[]     @relation("MessagesReceived")

  @@map("users")
}

model Property {
  id            String         @id @default(cuid())
  title         String
  description   String
  price         Int            // Prix en euros (entier — l'immobilier n'utilise pas les centimes)
  originalPrice Int?           // Prix initial avant baisse — pour l'historique Castorus
  surface       Int            // Surface habitable en m²
  rooms         Int            // Nombre de pièces
  bedrooms      Int?           // Nombre de chambres (optionnel)
  bathrooms     Int?           // Nombre de salles de bain (optionnel)
  constructionYear Int?         // Année de construction

  heatingType     String?      // "Gaz", "Électrique", "Pompe à chaleur", "Fioul", "Bois", "Autre"
  insulationLevel String?      // "Faible", "Moyenne", "Bonne"

  hasBalcony    Boolean        @default(false)
  hasTerrace    Boolean        @default(false)
  hasParking    Boolean        @default(false)
  hasElevator   Boolean        @default(false)
  hasCellar     Boolean        @default(false)

  dpe           Dpe
  energyAuditCost       Int?           // Coût estimé des travaux pour sortir de passoire thermique (F/G)
  latitude      Float
  longitude     Float
  city          String
  fairScore     Int            // Score d'équité DVF de 0 à 100 (≥80 = Prix juste)
  cityAvgPerSqm Int            // Prix moyen DVF de référence pour la commune (€/m²)
  images        String[]       @default([]) // Cloudinary secure_url list (ordered, first = cover)
  isBoosted     Boolean        @default(false)
  status        PropertyStatus @default(AVAILABLE)

  // Legal identification fields (added for notarial file completion)
  cadastralParcel       String?  // e.g. "AB 0042"
  fiscalInvariantNumber String?  // Invariant fiscal — identifiant officiel du bien
  lotNumbers            String?  // Numéros de lots (copropriété)
  tantiemes             Float?   // Tantièmes (parts de copropriété)
  isCopropriete         Boolean  @default(false)

  viewCount     Int            @default(0)        // Incremented on every page load

  source        String         @default("JUMO")   // "JUMO" | "SELOGER" | "BIENICI" | etc.
  externalUrl   String?
  externalId    String?        @unique

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Foreign key — nullable so external (scraped) listings have no seller
  sellerId      String?

  // Relations
  seller        User?      @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  savedBy       User[]     @relation("UserSavedProperties")
  offers        Offer[]
  documents     Document[]
  visits        Visit[]
  messages      Message[]
  leads         Lead[]

  @@index([sellerId])
  @@index([status])
  @@index([city])
  @@index([latitude, longitude]) // Geo bounding-box queries
  @@map("properties")
}

model Offer {
  id               String      @id @default(cuid())
  amount           Int         // Montant de l'offre en euros
  buyerName        String
  buyerEmail       String
  financingDetails String?     // Ex : "Prêt validé à 80% — Banque Postale — apport 40 000 €"
  validityDays     Int         @default(8)  // Durée de validité de l'offre en jours
  pdfUrl           String?     // URL de stockage du PDF généré (cloud storage optionnel)
  status           OfferStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Foreign key
  propertyId       String

  // Relations
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([status])
  @@map("offers")
}

model Document {
  id         String         @id @default(cuid())
  type       DocumentType
  url        String?        // Null tant que le fichier n'est pas encore téléversé
  status     DocumentStatus @default(MISSING)
  uploadedAt DateTime?      // Renseigné dès que le fichier est téléversé

  // Foreign key
  propertyId String

  // Relations
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, type]) // Un seul document de chaque type par annonce
  @@index([propertyId])
  @@map("documents")
}

model Visit {
  id              String      @id @default(cuid())
  propertyId      String
  buyerName       String
  buyerEmail      String
  slot            DateTime
  status          VisitStatus @default(PENDING)
  proofOfFundsUrl String?
  createdAt       DateTime    @default(now())

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("visits")
}

model Message {
  id         String   @id @default(cuid())
  propertyId String
  senderId   String?
  receiverId String?
  senderName String
  senderRole String
  body       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sender    User?    @relation("MessagesSent",     fields: [senderId],   references: [id], onDelete: SetNull)
  receiver  User?    @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

model Lead {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  postalCode  String
  rgpdConsent Boolean
  createdAt   DateTime @default(now())

  // Foreign key
  propertyId  String

  // Relations
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([email])
  @@map("leads")
}

// ─── Legal Identity — shared by buyer and seller profiles ─────────────────────

model CivilStatus {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  personType PersonType @default(PARTICULIER)

  // Particulier
  gender         Gender?
  firstName      String?
  lastName       String?
  maidenName     String?
  dateOfBirth    DateTime?
  placeOfBirth   String?
  nationality    String?   @default("Française")
  profession     String?
  currentAddress String?
  phoneNumber    String?
  maritalStatus  MaritalStatus?

  // Mariage / PACS (conditional on maritalStatus)
  dateOfMarriageOrPacs  DateTime?
  placeOfMarriageOrPacs String?
  matrimonialRegime     MatrimonialRegime?
  hasMarriageContract   Boolean  @default(false)
  notaryName            String?  // conditional on hasMarriageContract
  notaryCity            String?  // conditional on hasMarriageContract

  // Société
  companyName       String?
  siretNumber       String?
  registeredAddress String?
  managerName       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("civil_statuses")
}

// ─── Buyer Profile ────────────────────────────────────────────────────────────

model BuyerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purchasingCapacity     Int?    // Budget maximum en euros
  personalContribution   Int?    // Apport personnel en euros
  needsMortgage          Boolean @default(false)
  loanAmountRequested    Int?    // Montant du prêt souhaité (conditional on needsMortgage)
  isSellingPropertyToBuy Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("buyer_profiles")
}

// ─── Seller Profile ───────────────────────────────────────────────────────────

model SellerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic property intent
  propertyCity    String?
  propertyType    String?   // "Appartement" | "Maison" | "Terrain" | "Autre"
  propertySurface Int?
  estimatedPrice  Int?
  desiredSaleDate DateTime?
  hasAgentMandate Boolean   @default(false)
  mandateType     String?   // "exclusif" | "simple"

  // Legal property pre-fill (transferred to Property on listing creation)
  cadastralParcel       String?
  fiscalInvariantNumber String?
  isCopropriete         Boolean @default(false)
  lotNumbers            String? // conditional on isCopropriete
  tantiemes             Float?  // conditional on isCopropriete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seller_profiles")
}

// ─── Buyer Criteria — property search preferences for matching ────────────────

model BuyerCriteria {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Location — stored as JSON array of city name strings
  targetCities  Json    @default("[]")

  // Budget & size (required for matching)
  maxPrice   Int?
  minSurface Int?
  minRooms   Int?

  // Property types — stored as JSON array (e.g. ["Appartement","Maison"])
  propertyTypes Json    @default("[]")

  // Preferences
  wantsBalcony Boolean @default(false)
  wantsParking Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("buyer_criteria")
}
